#cloud-boothook
#!/bin/sh
# CAPTF machine pool bootstrap (aws-machinepool). cloud-init runs boothooks
# on every boot, in its init stage, before it reads its configuration for
# the module stages and before the payload's commands start the kubelet.
# This one registers the pool's node labels (on every boot; the fragment is
# idempotent), then, once per instance, downloads the bootstrap payload from
# S3 with the instance profile's credentials and installs it as system
# configuration in /etc/cloud/cloud.cfg.d, which cloud-init re-reads after
# the boothooks and before its init, config and final modules run (DESIGN.md
# decision 1, CONVENTIONS.md section 13).
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
export PATH
# --- CAPTF node labels: the shared fragment, verbatim ---
# shellcheck shell=sh
# CAPTF node labels (CONVENTIONS.md section 13), shared by every machine
# pool module; embed it verbatim. Input: node_labels, the labels the kubelet
# may set on itself, sorted and comma-joined ("k=v,k=v"; empty for none).
# Pool instances have no Machine, so nothing else puts the labels on their
# Nodes. POSIX sh. Safe to run on every boot: the block it adds is dropped
# first, and the image's own KUBELET_EXTRA_ARGS line is never edited, so a
# second run yields the same file.
captf_node_labels='${node_labels}'
# kubeadm's kubelet drop-in reads KUBELET_EXTRA_ARGS from /etc/default/kubelet
# (deb) or /etc/sysconfig/kubelet (rpm); the last assignment wins.
for captf_env_file in /etc/default/kubelet /etc/sysconfig/kubelet; do
  [ -d "$${captf_env_file%/*}" ] || continue
  captf_tmp="$captf_env_file.captf-tmp"
  if [ -f "$captf_env_file" ]; then
    sed '/^# captf-node-labels begin$/,/^# captf-node-labels end$/d' "$captf_env_file" >"$captf_tmp"
  else
    : >"$captf_tmp"
  fi
  if [ -n "$captf_node_labels" ]; then
    # The image's value, outside the block, without one level of quotes.
    captf_args=$(sed -n 's/^KUBELET_EXTRA_ARGS=//p' "$captf_tmp" | tail -n 1)
    case $captf_args in
      \"*\")
        captf_args=$${captf_args#\"}
        captf_args=$${captf_args%\"}
        ;;
      \'*\')
        captf_args=$${captf_args#\'}
        captf_args=$${captf_args%\'}
        ;;
    esac
    {
      printf '# captf-node-labels begin\n'
      printf 'KUBELET_EXTRA_ARGS="%s--node-labels=%s"\n' "$${captf_args:+$captf_args }" "$captf_node_labels"
      printf '# captf-node-labels end\n'
    } >>"$captf_tmp"
  fi
  # Nothing to write and nothing there before: create no file.
  if [ ! -e "$captf_env_file" ] && [ ! -s "$captf_tmp" ]; then
    rm -f "$captf_tmp"
    continue
  fi
  chmod 0644 "$captf_tmp"
  mv "$captf_tmp" "$captf_env_file"
done
# RKE2 merges config.yaml.d files into its config; "+" appends to the labels
# the bootstrap configuration sets
# (https://docs.rke2.io/install/configuration#multiple-config-files).
captf_rke2_file=/etc/rancher/rke2/config.yaml.d/50-captf-node-labels.yaml
if [ -n "$captf_node_labels" ]; then
  mkdir -p "$${captf_rke2_file%/*}"
  {
    printf 'node-label+:\n'
    (
      set -f
      IFS=,
      for captf_label in $captf_node_labels; do
        printf '  - "%s"\n' "$captf_label"
      done
    )
  } >"$captf_rke2_file.captf-tmp"
  chmod 0644 "$captf_rke2_file.captf-tmp"
  mv "$captf_rke2_file.captf-tmp" "$captf_rke2_file"
else
  rm -f "$captf_rke2_file"
fi
# --- CAPTF staging stub: canonical head (CONVENTIONS.md section 13) ---
umask 077
config=/etc/cloud/cloud.cfg.d/99-captf-bootstrap.cfg
[ -s "$config" ] && exit 0
mkdir -p /etc/cloud/cloud.cfg.d
# Temporary names without .cfg: cloud-init reads only *.cfg there.
fetched=$(mktemp /etc/cloud/cloud.cfg.d/.captf-fetched.XXXXXX)
decoded=$(mktemp /etc/cloud/cloud.cfg.d/.captf-decoded.XXXXXX)
trap 'rm -f "$fetched" "$decoded"' EXIT
# --- cloud-specific: fetch the payload into "$fetched" ---
attempt=1
until aws s3 cp --only-show-errors --region '${region}' 's3://${bucket}/${key}' "$fetched"; do
  if [ "$attempt" -ge 60 ]; then
    echo "captf: giving up on s3://${bucket}/${key} after $attempt attempts" >&2
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 5
done
# --- CAPTF staging stub: canonical tail (CONVENTIONS.md section 13) ---
# Decompress a gzip payload, accept only cloud-config (a "#cloud-config"
# document, or a "## template: jinja" one, as CABPK writes, that renders
# to cloud-config), and install it 0600 through a temporary file in the
# same directory. A shell script or MIME payload is refused, not installed.
if [ "$(od -An -tx1 -N2 "$fetched" | tr -d ' \n')" = 1f8b ]; then
  gzip -dc "$fetched" >"$decoded"
else
  cat "$fetched" >"$decoded"
fi
captf_first=$(sed -n '1p' "$decoded" | tr -d '\r')
captf_second=$(sed -n '2p' "$decoded" | tr -d '\r')
case $captf_first in
  '#cloud-config'*) ;;
  '## template: jinja'*)
    case $captf_second in
      '#cloud-config'*) ;;
      *)
        echo "captf: the bootstrap payload is a Jinja template but not cloud-config; refusing it" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "captf: the bootstrap payload is not cloud-config; refusing it" >&2
    exit 1
    ;;
esac
chmod 0600 "$decoded"
mv "$decoded" "$config"
